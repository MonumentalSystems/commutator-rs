{
  "schema": "clifford-golden-v1",
  "blade_encoding": "unsigned bitmap; bit i denotes generator i",
  "metric": "bits [0,p) square +1; bits [p,p+q) square -1",
  "canonical_order": "grade ascending, then bitmap ascending",
  "term_encoding": "[blade_bitmap, coefficient]",
  "provenance": {
    "versor_repository": "https://github.com/DavinciDreams/versor-rs",
    "versor_commit": "93a5a1334ab77131e5ef6b88105cdaac57d267e6",
    "notes": "Values are stored by bitmap. Versor raw commutators have scale 1; clifford-core commutators have scale 0.5."
  },
  "basis_cases": [
    {
      "id": "basis_cl30_full",
      "signature": [3, 0],
      "grade": null,
      "expected_bitmaps": [0, 1, 2, 4, 3, 5, 6, 7]
    },
    {
      "id": "basis_cl13_grade2",
      "signature": [1, 3],
      "grade": 2,
      "expected_bitmaps": [3, 5, 6, 9, 10, 12]
    },
    {
      "id": "basis_cl60_grade2",
      "signature": [6, 0],
      "grade": 2,
      "expected_bitmaps": [3, 5, 6, 9, 10, 12, 17, 18, 20, 24, 33, 34, 36, 40, 48]
    }
  ],
